{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "epistel volume index",
 "description": "Volume titles, correspondence groups, the letters' document order (the edition's reading order), parser warnings per volume, and each volume's source TEI files. See docs/export-format.md.",
 "type": "object",
 "required": ["volumes"],
 "additionalProperties": false,
 "properties": {
  "volumes": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": ["volume", "title", "shortTitle", "source", "groups", "letters", "warnings"],
    "additionalProperties": false,
    "properties": {
     "volume": {"type": "string", "pattern": "^b[0-9]+$"},
     "title": {"type": "string"},
     "shortTitle": {"type": "string"},
     "source": {
      "description": "The volume's TEI files by basename, with upstream path and sha256 from the provenance record; null when no record exists.",
      "anyOf": [
       {"type": "null"},
       {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": {
         "type": "object",
         "required": ["path", "sha256"],
         "additionalProperties": false,
         "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
         }
        }
       }
      ]
     },
     "groups": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["id", "heading", "notes", "letterIds"],
       "additionalProperties": false,
       "properties": {
        "id": {"type": ["string", "null"]},
        "heading": {"type": ["string", "null"]},
        "notes": {"type": "array", "items": {"type": "string"}},
        "letterIds": {"type": "array", "items": {"type": "string"}}
       }
      }
     },
     "letters": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "object",
       "required": ["volume", "xmlId", "number"],
       "additionalProperties": false,
       "properties": {
        "volume": {"type": "string"},
        "xmlId": {"type": "string"},
        "number": {"type": "string"}
       }
      }
     },
     "warnings": {
      "type": "array",
      "items": {
       "type": "object",
       "required": ["letterId", "tag", "message"],
       "additionalProperties": false,
       "properties": {
        "letterId": {"type": ["string", "null"]},
        "tag": {"type": "string"},
        "message": {"type": "string"}
       }
      }
     }
    }
   }
  }
 }
}
